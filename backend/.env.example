# Copia este archivo como backend/.env (lo usan los dos microservicios) y completa con los datos de Supabase:
# Supabase → Connect → Session pooler. No subas el .env a GitHub.
SUPABASE_DB_URL=jdbc:postgresql://aws-1-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres.REF_DEL_PROYECTO
SUPABASE_DB_PASSWORD=
